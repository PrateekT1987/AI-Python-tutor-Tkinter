# Copy this file to .env and fill in the values.
# Only OpenRouter is supported by this project.

# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Required: any OpenRouter model id, e.g. the free Nemotron build
MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional (defaults shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAX_TOKENS=2000

# Optional: attribution shown on your OpenRouter dashboard
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Python Tutor

# Optional sandbox tuning
# TUTOR_MEMORY_MB=512
# TUTOR_ALLOW_NETWORK=0

# Optional reliability / context tuning
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_SECONDS=0.8
# LLM_TIMEOUT_SECONDS=60
# MAX_CONTEXT_CHARS=24000
